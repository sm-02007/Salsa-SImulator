                        </div>
                        <span class="atributo-valor">—</span>
                    </div>

                </div>
            </section>

            <!-- COLOR Y TEXTURA -->
            <section class="seccion-color-textura">
                <h2>🎨 Color y Textura</h2>
                <div class="color-textura-grid">
                    <div class="resultado-item">
                        <span class="resultado-label">Color esperado</span>
                        <span class="resultado-valor" id="color-esperado">—</span>
                    </div>
                    <div class="resultado-item">
                        <span class="resultado-label">Textura estimada</span>
                        <span class="resultado-valor" id="textura-estimada">—</span>
                    </div>
                </div>
            </section>

            <!-- PREDICCIÓN TEXTUAL -->
            <section class="seccion-prediccion">
                <h2>🔮 Predicción</h2>
                <p class="prediccion-texto" id="prediccion-texto">
                    Completá los ingredientes y presioná <strong>Calcular</strong> para ver la predicción.
                </p>
            </section>

            <!-- RECOMENDACIONES -->
            <section class="seccion-recomendaciones">
                <h2>💡 Recomendaciones</h2>
                <ul class="lista-recomendaciones" id="lista-recomendaciones">
                    <li class="recomendacion-placeholder">Las recomendaciones aparecen después de calcular.</li>
                </ul>
            </section>

        </main>

