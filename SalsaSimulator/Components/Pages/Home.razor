@page "/"
@rendermode InteractiveServer
@using SalsaSimulator.Models
@using SalsaSimulator.Data
@using Microsoft.EntityFrameworkCore
@inject SalsaDbContext Db
@inject SalsaCalculatorService Calculator

<PageTitle>Simulador de Salsa Picante</PageTitle>

@code {
    private List<Aji> ajies = new();
    private List<Build> builds = new();
    private RecetaInput input = new();
    private PerfilSalsa? perfil = null;
    private bool calculando = false;

    protected override async Task OnInitializedAsync()
    {
        ajies = await Db.Ajies.OrderBy(a => a.Nombre).ToListAsync();
        builds = await Db.Builds.ToListAsync();
        for (int i = 0; i < 10; i++)
            input.Ajies.Add(new AjiInput());
    }

    private async Task Calcular()
    {
        calculando = true;
        await Task.Yield();
        perfil = Calculator.Calcular(input, ajies);
        calculando = false;
    }

    private void Limpiar()
    {
        input = new RecetaInput();
        for (int i = 0; i < 10; i++)
            input.Ajies.Add(new AjiInput());
        perfil = null;
    }

    private void CargarBuild(Build build)
    {
        Limpiar();
        var composicion = System.Text.Json.JsonSerializer
            .Deserialize<List<ComposicionItem>>(build.ComposicionJson) ?? new();
        for (int i = 0; i < composicion.Count && i < 10; i++)
        {
            input.Ajies[i].Nombre = composicion[i].nombre;
            input.Ajies[i].Gramos = composicion[i].porcentaje * 2;
        }
        input.DiasFerrmentacion = build.DiasFerrmentacion;
        perfil = null;
    }

    private string Porcentaje(int index)
    {
        var total = input.Ajies.Where(a => a.Gramos > 0).Sum(a => a.Gramos);
        if (total == 0 || input.Ajies[index].Gramos == 0) return "0%";
        return $"{input.Ajies[index].Gramos / total * 100:F0}%";
    }

    private string InfoRapida(int index)
    {
        var nombre = input.Ajies[index].Nombre;
        if (string.IsNullOrEmpty(nombre)) return "—";
        var aji = ajies.FirstOrDefault(a => a.Nombre == nombre);
        return aji is null ? "—" : $"🌶 {aji.Picante}/10 · {aji.ScovilleEstimado} SHU";
    }

    private string Barra(double valor) => $"{valor * 10:F0}%";

    private string ColorBarra(double valor) => valor switch
    {
        >= 8 => "#e53e3e",
        >= 6 => "#ed8936",
        >= 4 => "#ecc94b",
        _ => "#68d391"
    };

    private string ClaseRecomendacion(string tipo) => tipo switch
    {
        "warning" => "rec-warning",
        "sugerencia" => "rec-sugerencia",
        _ => "rec-ok"
    };

    private record ComposicionItem(string nombre, double porcentaje);
}

<div class="simulador-container">

    <!-- ===== HEADER ===== -->
    <header class="simulador-header">
        <h1>🌶 Simulador de Salsa Picante</h1>
        <p>Construí tu salsa · Elegí ingredientes · Predecí el resultado</p>
    </header>

    <!-- ===== CUERPO PRINCIPAL ===== -->
    <div class="simulador-body">

        <!-- ========== COLUMNA IZQUIERDA: FORMULARIO ========== -->
        <aside class="panel-formulario">

            <!-- SECCIÓN: Ajíes -->
            <section class="seccion-ajies">
                <h2>🌶 Ajíes / Chiles</h2>
                <p>Podés agregar hasta 10 ajíes. Los porcentajes se calculan automáticamente.</p>

                <table class="tabla-ajies">
                    <thead>
                        <tr>
                            <th>Ají / Chile</th>
                            <th>Gramos</th>
                            <th>% Total</th>
                            <th>Info Rápida</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < 10; i++)
                        {
                            var idx = i;
                            <tr>
                                <td>
                                    <select @bind="input.Ajies[idx].Nombre">
                                        <option value="">— Elegir ají —</option>
                                        @foreach (var aji in ajies)
                                        {
                                            <option value="@aji.Nombre">@aji.Nombre</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <input type="number"
                                           @bind="input.Ajies[idx].Gramos"
                                           min="0" placeholder="g" />
                                </td>
                                <td>
                                    <span class="porcentaje">@Porcentaje(idx)</span>
                                </td>
                                <td>
                                    <span class="info-rapida">@InfoRapida(idx)</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>

            <!-- SECCIÓN: Ingredientes extra -->
            <section class="seccion-ingredientes">
                <h2>🧪 Ingredientes extra</h2>

                <div class="ingredientes-grid">

                    <div class="ingrediente-item">
                        <label>🧄 Ajo</label>
                        <input type="number" @bind="input.Ajo" min="0" placeholder="0" />
                        <span class="unidad">dientes</span>
                    </div>

                    <div class="ingrediente-item">
                        <label>🧅 Cebolla blanca</label>
                        <input type="number" @bind="input.CebollaBlanca" min="0" placeholder="0" />
                        <span class="unidad">g</span>
                    </div>

                    <div class="ingrediente-item">
                        <label>🧅 Cebolla morada</label>
                        <input type="number" @bind="input.CebollaMorada" min="0" placeholder="0" />
                        <span class="unidad">g</span>
                    </div>

                    <div class="ingrediente-item">
                        <label>🥕 Zanahoria</label>
                        <input type="number" @bind="input.Zanahoria" min="0" placeholder="0" />
                        <span class="unidad">g</span>
                    </div>

                    <div class="ingrediente-item">
                        <label>🥭 Mango</label>
                        <input type="number" @bind="input.Mango" min="0" placeholder="0" />
                        <span class="unidad">g</span>
                    </div>

                    <div class="ingrediente-item">
                        <label>🍍 Piña</label>
                        <input type="number" @bind="input.Pina" min="0" placeholder="0" />
                        <span class="unidad">g</span>
                    </div>

                    <div class="ingrediente-item">
                        <label>🍎 Manzana</label>
                        <input type="number" @bind="input.Manzana" min="0" placeholder="0" />
                        <span class="unidad">g</span>
                    </div>

                    <div class="ingrediente-item">
                        <label>🍅 Tomate</label>
                        <input type="number" @bind="input.Tomate" min="0" placeholder="0" />
                        <span class="unidad">g</span>
                    </div>

                    <div class="ingrediente-item">
                        <label>🫑 Morrón</label>
                        <input type="number" @bind="input.Morron" min="0" placeholder="0" />
                        <span class="unidad">g</span>
                    </div>

                    <div class="ingrediente-item">
                        <label>🍯 Miel</label>
                        <input type="number" @bind="input.Miel" min="0" placeholder="0" />
                        <span class="unidad">g</span>
                    </div>

                    <div class="ingrediente-item">
                        <label>🍬 Azúcar</label>
                        <input type="number" @bind="input.Azucar" min="0" placeholder="0" />
                        <span class="unidad">g</span>
                    </div>

                    <div class="ingrediente-item">
                        <label>🫙 Vinagre blanco</label>
                        <input type="number" @bind="input.VinagreBlanco" min="0" placeholder="0" />
                        <span class="unidad">ml</span>
                    </div>

                    <div class="ingrediente-item">
                        <label>🍶 Vinagre de manzana</label>
                        <input type="number" @bind="input.VinagreManzana" min="0" placeholder="0" />
                        <span class="unidad">ml</span>
                    </div>

                    <div class="ingrediente-item">
                        <label>🍋 Limón / Lima (jugo)</label>
                        <input type="number" @bind="input.Limon" min="0" placeholder="0" />
                        <span class="unidad">ml</span>
                    </div>

                    <div class="ingrediente-item">
                        <label>🌿 Especias</label>
                        <input type="range" @bind="input.Especias" min="0" max="5" step="1" />
                        <span class="unidad">nivel @input.Especias/5</span>
                    </div>

                </div>
            </section>

            <!-- SECCIÓN: Fermentación -->
            <section class="seccion-fermentacion">
                <h2>🧪 Fermentación</h2>

                <div class="fermentacion-grid">

                    <div class="ingrediente-item">
                        <label>🧂 Sal</label>
                        <input type="number" @bind="input.SalPorcentaje"
                               min="0" max="10" step="0.1" placeholder="2.0" />
                        <span class="unidad">%</span>
                    </div>

                    <div class="ingrediente-item">
                        <label>📅 Días de fermentación</label>
                        <input type="number" @bind="input.DiasFerrmentacion"
                               min="0" max="30" placeholder="5" />
                        <span class="unidad">días</span>
                    </div>

                    <div class="ingrediente-item">
                        <label>🌡️ Temperatura</label>
                        <input type="number" @bind="input.TemperaturaC"
                               min="0" max="50" placeholder="25" />
                        <span class="unidad">°C</span>
                    </div>

                </div>

                <div class="guia-fermentacion">
                    <h3>Guía rápida</h3>
                    <ul>
                        <li><strong>1–3 días:</strong> Fresco, menos ácido. Para salsas frescas.</li>
                        <li><strong>4–7 días ✅:</strong> Ideal. Equilibrio frescura y profundidad.</li>
                        <li><strong>8–14 días:</strong> Más ácido y complejo. Estilo hot sauce americano.</li>
                        <li><strong>+14 días:</strong> Muy ácido. Requiere control estricto.</li>
                    </ul>
                </div>
            </section>

            <!-- BOTONES -->
            <div class="acciones-formulario">
                <button type="button" class="btn-calcular"
                        @onclick="Calcular" disabled="@calculando">
                    @(calculando ? "⏳ Calculando..." : "🔥 Calcular Perfil de Salsa")
                </button>
                <button type="button" class="btn-limpiar" @onclick="Limpiar">
                    🗑 Limpiar todo
                </button>
            </div>

        </aside>

        <!-- ========== COLUMNA DERECHA: RESULTADOS ========== -->
        <main class="panel-resultados">

            @if (perfil is null)
            {
                <div class="placeholder-resultados">
                    <p>🌶 Completá los ingredientes y presioná <strong>Calcular</strong> para ver el perfil.</p>
                </div>
            }
            else
            {
                <!-- PERFIL DE SABOR -->
                <section class="seccion-perfil">
                    <h2>📊 Perfil de Sabor</h2>
                    <div class="atributos-lista">

                        @foreach (var (icono, nombre, valor) in new[]
                        {
                            ("🌶",  "Picante",           perfil.Picante),
                            ("🍬",  "Dulzor",            perfil.Dulzor),
                            ("🍋",  "Acidez",            perfil.Acidez),
                            ("🌴",  "Tropical / Frutal", perfil.TropicalFrutal),
                            ("🧪",  "Umami",             perfil.Umami),
                            ("🎭",  "Complejidad",       perfil.Complejidad),
                            ("🌿",  "Frescura",          perfil.Frescura),
                            ("🔥",  "Ahumado",           perfil.Ahumado),
                            ("😭",  "Ferocidad",         perfil.Ferocidad),
                            ("⚖️", "Balance",            perfil.Balance),
                            ("⏳",  "Persistencia",      perfil.Persistencia),
                        })
                        {
                            <div class="atributo-item">
                                <span class="atributo-icono">@icono</span>
                                <span class="atributo-nombre">@nombre</span>
                                <div class="barra-contenedor">
                                    <div class="barra-relleno"
                                         style="width: @Barra(valor); background-color: @ColorBarra(valor);">
                                    </div>
                                </div>
                                <span class="atributo-valor">@valor/10</span>
                            </div>
                        }

                    </div>
                </section>

                <!-- COLOR Y TEXTURA -->
                <section class="seccion-color-textura">
                    <h2>🎨 Color y Textura</h2>
                    <div class="color-textura-grid">
                        <div class="resultado-item">
                            <span class="resultado-label">Color esperado</span>
                            <span class="resultado-valor">@perfil.ColorEsperado</span>
                        </div>
                        <div class="resultado-item">
                            <span class="resultado-label">Textura estimada</span>
                            <span class="resultado-valor">@perfil.TexturaEstimada</span>
                        </div>
                    </div>
                </section>

                <!-- PREDICCIÓN TEXTUAL -->
                <section class="seccion-prediccion">
                    <h2>🔮 Predicción</h2>
                    <p class="prediccion-texto">@perfil.PrediccionTextual</p>
                </section>

                <!-- RECOMENDACIONES -->
                <section class="seccion-recomendaciones">
                    <h2>💡 Recomendaciones</h2>
                    <ul class="lista-recomendaciones">
                        @foreach (var rec in perfil.Recomendaciones)
                        {
                            <li class="@ClaseRecomendacion(rec.Tipo)">@rec.Mensaje</li>
                        }
                    </ul>
                </section>
            }

        </main>

    </div>

    <!-- ===== BIBLIOTECA DE BUILDS ===== -->
    <section class="seccion-builds">
        <h2>📚 Recetas Pre-armadas</h2>
        <p>Hacé click en una receta para cargarla en el simulador.</p>

        <div class="builds-grid">
            @foreach (var build in builds)
            {
                <article class="build-card @(build.EsPeligrosa ? "build-peligrosa" : "")">
                    <h3>@build.Emoji @build.Nombre</h3>
                    <p>@build.Ingredientes</p>
                    <div class="build-meta">
                        <span class="build-picante">🌶 @build.Picante/10</span>
                        <span class="build-dias">📅 @build.DiasFerrmentacion días</span>
                    </div>
                    <p class="build-descripcion">@build.NotasSabor</p>
                    @if (build.EsPeligrosa)
                    {
                        <p class="build-advertencia">⚠️ Nivel: PELIGRO BIOLÓGICO</p>
                    }
                    <button type="button" class="btn-cargar-build"
                            @onclick="() => CargarBuild(build)">
                        Cargar receta
                    </button>
                </article>
            }
        </div>
    </section>

</div>