                            </td>
                            <td>
                                <span class="info-rapida">—</span>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td><strong>Total</strong></td>
                            <td><span class="total-gramos">0 g</span></td>
                            <td><span class="total-porcentaje">0%</span></td>
                            <td>
                                <!-- Indica si los % suman 100 o no -->
                                <span class="validacion-porcentaje">—</span>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </section>

            <!-- SECCIÓN: Ingredientes Extra -->
            <section class="seccion-ingredientes-extra">
                <h2>🧅 Ingredientes Extra</h2>

                <div class="ingredientes-grid">

                    <!-- Ajo -->
                    <div class="ingrediente-item">
                        <label for="ajo">🧄 Ajo</label>
                        <input type="number" id="ajo" name="ajo" min="0" placeholder="0" />
                        <span class="unidad">dientes</span>
                    </div>

                    <!-- Cebolla blanca -->
                    <div class="ingrediente-item">
                        <label for="cebolla_blanca">🧅 Cebolla blanca</label>
                        <input type="number" id="cebolla_blanca" name="cebolla_blanca" min="0" placeholder="0" />
                        <span class="unidad">g</span>
                    </div>

                    <!-- Cebolla morada -->
                    <div class="ingrediente-item">
                        <label for="cebolla_morada">🟣 Cebolla morada</label>
                        <input type="number" id="cebolla_morada" name="cebolla_morada" min="0" placeholder="0" />
                        <span class="unidad">g</span>
                    </div>

                    <!-- Zanahoria -->
                    <div class="ingrediente-item">
                        <label for="zanahoria">🥕 Zanahoria</label>
                        <input type="number" id="zanahoria" name="zanahoria" min="0" placeholder="0" />
                        <span class="unidad">g</span>
                    </div>

                    <!-- Mango -->
                    <div class="ingrediente-item">
                        <label for="mango">🥭 Mango</label>
                        <input type="number" id="mango" name="mango" min="0" placeholder="0" />
                        <span class="unidad">g</span>
                    </div>

                    <!-- Piña -->
                    <div class="ingrediente-item">
                        <label for="pina">🍍 Piña</label>
                        <input type="number" id="pina" name="pina" min="0" placeholder="0" />
                        <span class="unidad">g</span>
                    </div>

                    <!-- Manzana -->
                    <div class="ingrediente-item">
                        <label for="manzana">🍎 Manzana</label>
                        <input type="number" id="manzana" name="manzana" min="0" placeholder="0" />
                        <span class="unidad">g</span>
                    </div>

                    <!-- Tomate -->
                    <div class="ingrediente-item">
                        <label for="tomate">🍅 Tomate</label>
                        <input type="number" id="tomate" name="tomate" min="0" placeholder="0" />
                        <span class="unidad">g</span>
                    </div>

                    <!-- Morrón -->
                    <div class="ingrediente-item">
                        <label for="morron">🫑 Morrón</label>
                        <input type="number" id="morron" name="morron" min="0" placeholder="0" />
                        <span class="unidad">g</span>
                    </div>

                    <!-- Miel -->
                    <div class="ingrediente-item">
                        <label for="miel">🍯 Miel</label>
                        <input type="number" id="miel" name="miel" min="0" placeholder="0" />
                        <span class="unidad">g</span>
                    </div>

                    <!-- Azúcar -->
                    <div class="ingrediente-item">
                        <label for="azucar">🍬 Azúcar</label>
                        <input type="number" id="azucar" name="azucar" min="0" placeholder="0" />
                        <span class="unidad">g</span>
                    </div>

                    <!-- Vinagre blanco -->
                    <div class="ingrediente-item">
                        <label for="vinagre_blanco">🫙 Vinagre blanco</label>
                        <input type="number" id="vinagre_blanco" name="vinagre_blanco" min="0" placeholder="0" />
                        <span class="unidad">ml</span>
                    </div>

                    <!-- Vinagre de manzana -->
                    <div class="ingrediente-item">
                        <label for="vinagre_manzana">🍶 Vinagre de manzana</label>
                        <input type="number" id="vinagre_manzana" name="vinagre_manzana" min="0" placeholder="0" />
                        <span class="unidad">ml</span>
                    </div>

                    <!-- Limón / Lima -->
                    <div class="ingrediente-item">
                        <label for="limon">🍋 Limón / Lima (jugo)</label>
                        <input type="number" id="limon" name="limon" min="0" placeholder="0" />
                        <span class="unidad">ml</span>
                    </div>

                    <!-- Especias -->
                    <div class="ingrediente-item">
                        <label for="especias">🌿 Especias</label>
                        <input type="range" id="especias" name="especias" min="0" max="5" step="1" value="0" />
                        <span class="unidad">nivel 0–5</span>
                    </div>

                </div>
            </section>

            <!-- SECCIÓN: Parámetros de Fermentación -->
            <section class="seccion-fermentacion">
                <h2>🧪 Fermentación</h2>

                <div class="fermentacion-grid">

                    <div class="ingrediente-item">
                        <label for="sal">🧂 Sal</label>
                        <input type="number" id="sal" name="sal" min="0" max="10" step="0.1" placeholder="2.0" />
                        <span class="unidad">%</span>
                    </div>

                    <div class="ingrediente-item">
                        <label for="dias_fermentacion">📅 Días de fermentación</label>
                        <input type="number" id="dias_fermentacion" name="dias_fermentacion" min="0" max="30" placeholder="5" />
                        <span class="unidad">días</span>
                    </div>

                    <div class="ingrediente-item">
                        <label for="temperatura">🌡️ Temperatura</label>
                        <input type="number" id="temperatura" name="temperatura" min="0" max="50" placeholder="25" />
                        <span class="unidad">°C</span>
                    </div>

                </div>

                <!-- Guía de fermentación (solo texto, referencia para el usuario) -->
                <div class="guia-fermentacion">
                    <h3>Guía rápida</h3>
                    <ul>
                        <li><strong>1–3 días:</strong> Fresco, menos ácido. Para salsas frescas.</li>
                        <li><strong>4–7 días ✅:</strong> Ideal. Equilibrio frescura y profundidad.</li>
                        <li><strong>8–14 días:</strong> Más ácido y complejo. Estilo hot sauce americano.</li>
                        <li><strong>+14 días:</strong> Muy ácido. Requiere control estricto.</li>
                    </ul>
                </div>
            </section>

            <!-- BOTÓN PRINCIPAL -->
            <div class="acciones-formulario">
                <button type="button" class="btn-calcular">
                    🔥 Calcular Perfil de Salsa
                </button>
                <button type="button" class="btn-limpiar">
                    🗑 Limpiar todo
                </button>
            </div>

        </aside>

        <!-- ========== COLUMNA DERECHA: RESULTADOS ========== -->
        <main class="panel-resultados">

            <!-- PERFIL DE SABOR -->
            <section class="seccion-perfil">
                <h2>📊 Perfil de Sabor</h2>

                <div class="atributos-lista">

                    <div class="atributo-item">
                        <span class="atributo-icono">🌶</span>
                        <span class="atributo-nombre">Picante</span>
                        <div class="barra-contenedor">
                            <div class="barra-relleno" style="width: 0%"></div>
                        </div>
                        <span class="atributo-valor">—</span>
                    </div>

                    <div class="atributo-item">
                        <span class="atributo-icono">🍬</span>
                        <span class="atributo-nombre">Dulzor</span>
