    <!-- ===== BIBLIOTECA DE BUILDS (debajo del simulador) ===== -->
    <section class="seccion-builds">
        <h2>📚 Recetas Pre-armadas</h2>
        <p>Hacé click en una receta para cargarla en el simulador.</p>

        <div class="builds-grid">

            <article class="build-card">
                <h3>🌴 Tropical Gourmet</h3>
                <p>Habanero 40% · Mango 20% · Piña 10% · Zanahoria 15%</p>
                <div class="build-meta">
                    <span class="build-picante">🌶 7/10</span>
                    <span class="build-dias">📅 5 días</span>
                </div>
                <p class="build-descripcion">Tropical explosivo, frutal, dulce-picante, floral.</p>
                <button type="button" class="btn-cargar-build" data-build="tropical-gourmet">
                    Cargar receta
                </button>
            </article>

            <article class="build-card">
                <h3>🇲🇽 Mexicana Verde</h3>
